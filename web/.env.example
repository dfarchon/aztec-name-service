# Exactly one RPC endpoint. Only local defaults to http://localhost:8080.
# Public profiles require HTTPS and pinned identity, with no localhost fallback.
# Explicit public profiles may use HTTP loopback fixtures in DEV only.
VITE_NODE_URL=http://localhost:8080
# NameRegistry deployment (required).
VITE_REGISTRY=
# Optional display suffix stripped from input, e.g. .aztec
VITE_NAME_SUFFIX=
# DEV embedded wallet only; external wallets generate their own proofs.
# true = testnet; false = local network without proofs. Remote mock proofs are refused.
VITE_PROVER_ENABLED=false
# Optional SponsoredFPC address; external wallets choose their fee method when unset.
VITE_SPONSORED_FPC=
# Optional web wallet URLs, separated by commas; extensions are discovered automatically.
VITE_WEB_WALLET_URLS=
# Development only. Never enabled in a production build.
VITE_DEVELOPMENT_WALLET=false

# DEV defaults to local (chain 31337). Public profiles must be explicit:
# VITE_NETWORK=testnet-v6|mainnet; VITE_FEE_PAYMENT=sponsored|fee-juice
# Public chain/rollup pins must match the selected profile; local rollup is optional.
VITE_CHAIN_ID=
VITE_ROLLUP_VERSION=
VITE_TELEMETRY=false
