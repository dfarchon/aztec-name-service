// PLACEHOLDER: REGISTRY, OPERATOR and D1 database_id remain undecided until contract deployment.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "fog-mainnet",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fog-mainnet-monitor",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "RPC_URL": "https://aztec-mainnet.drpc.org",
    "REGISTRY": "UNDECIDED",
    "SITE_URL": "https://fog-mainnet.huantian233.workers.dev",
    "CHAIN_ID": "1",
    "ROLLUP_VERSION": "2070860440",
    "ROLLUP": "0xe37a2663cc9c119ba41572c40fab0bbb23a5402f",
    "FEE_PAYMENT": "fee-juice",
    "NETWORK_LABEL": "mainnet",
    "OPERATOR": "UNDECIDED",
    "OPERATOR_BALANCE_SLOT": "UNDECIDED",
    "OPERATOR_LOW_WATERMARK": "UNDECIDED",
    "BLOCK_STALE_SECONDS": "600"
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "services": [
    {
      "binding": "MONITOR",
      "service": "fog-mainnet-monitor"
    }
  ],
  "ratelimits": [
    {
      "name": "RUM_LIMITER",
      "namespace_id": "81020261120",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ]
}
