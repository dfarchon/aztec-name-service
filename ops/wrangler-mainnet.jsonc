// Canonical Aztec Mainnet V8 Free Launch configuration.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "fog-mainnet",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fog-mainnet-monitor",
      "database_id": "8fcde0ea-d05d-4394-8b59-4575aefe2d07"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "RPC_URL": "https://aztec-mainnet.drpc.org",
    "REGISTRY": "0x1fa493d7fe8b41fff6b6dc9999b3c8a64d3cb47c50283aa75da089a16c20b7e1",
    "SITE_URL": "https://fog-mainnet.huantian233.workers.dev",
    "CHAIN_ID": "1",
    "ROLLUP_VERSION": "2070860440",
    "ROLLUP": "0xe37a2663cc9c119ba41572c40fab0bbb23a5402f",
    "FEE_PAYMENT": "fee-juice",
    "NETWORK_LABEL": "mainnet",
    "OPERATOR": "0x1475daff425d690976db59e6c2d1a13b1de8a533ad2cbdaecfd6db9e8a26f124",
    "OPERATOR_BALANCE_SLOT": "0x12d2dedffbdeae16cff2503a8699f03fe2156d6bb58d3742ecaee5315615140c",
    "OPERATOR_LOW_WATERMARK": "1000000000000000000",
    "BLOCK_STALE_SECONDS": "600"
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "services": [
    {
      "binding": "MONITOR",
      "service": "fog-mainnet-monitor"
    }
  ],
  "ratelimits": [
    {
      "name": "RUM_LIMITER",
      "namespace_id": "81020261120",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ]
}
